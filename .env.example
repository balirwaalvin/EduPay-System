# ===========================================================================
# EduPay environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Firebase (required)
# ---------------------------------------------------------------------------
# The server talks to Firestore with the Admin SDK, which needs a SERVICE
# ACCOUNT — not the web config (apiKey/authDomain/...). The web config is a
# browser artefact and cannot authenticate a server.
#
# Get one from: Firebase console -> Project settings -> Service accounts
#               -> "Generate new private key"
#
# Then supply it in ONE of these ways:
#
#   1. Inline JSON (best for hosted platforms; keep it on a single line)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"edupay-ug",...}
#
#   2. Base64-encoded JSON (avoids newline mangling in some dashboards)
#      Produce it with:  base64 -w0 serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=
#
#   3. A path to the JSON file (best for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# On Google Cloud (Cloud Run, App Engine, GCE) none of these are needed —
# Application Default Credentials are picked up automatically.

FIREBASE_PROJECT_ID=edupay-ug

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# At least 32 characters. The server REFUSES TO START in production without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long an access token stays valid.
JWT_TTL=2h

# bcrypt work factor. Higher is slower and stronger.
BCRYPT_ROUNDS=12

# Minimum password length. The policy also requires three of:
# lowercase, uppercase, digits, symbols.
PASSWORD_MIN_LENGTH=10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public base URL, used to build links in emails. Without it, the request's
# own host is used — set it explicitly behind a proxy or CDN.
# BASE_URL=https://payroll.yourschool.ac.ug

# Comma-separated browser origins allowed to call the API. Leave empty when the
# API and the pages are served from the same origin, which is the default.
# ALLOWED_ORIGINS=https://payroll.yourschool.ac.ug

# Proxy hops to trust when reading the client IP for rate limiting and the
# audit log. 1 suits a single load balancer.
TRUST_PROXY_HOPS=1

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Email (strongly recommended)
# ---------------------------------------------------------------------------
# Without SMTP the system still runs, but it cannot send password setup links,
# password resets or two-factor codes. New accounts then fall back to a
# one-time temporary password shown to the administrator instead, and
# two-factor authentication stays off because codes could not be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yourschool.ac.ug

# ---------------------------------------------------------------------------
# Two-factor authentication and tokens
# ---------------------------------------------------------------------------
MFA_TOKEN_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
PASSWORD_SETUP_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Sign-in and verify attempts per IP per 15 minutes.
RATE_LIMIT_AUTH=20
# Email-sending requests per IP per hour.
RATE_LIMIT_EMAIL=5
# All API requests per IP per minute.
RATE_LIMIT_API=300

# ---------------------------------------------------------------------------
# First-run seeding (npm run db:seed)
# ---------------------------------------------------------------------------
# Only used when no administrator exists yet. Leave SEED_ADMIN_PASSWORD unset
# to have a strong one generated and printed once.
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Local development against the Firestore emulator
# ---------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=localhost:8080
