# ===========================================================================
# EduPay environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database — Google Cloud SQL for PostgreSQL (required)
# ---------------------------------------------------------------------------
# Pick ONE of the three connection styles below.
#
# 1. UNIX SOCKET — how Cloud Run, App Engine and Cloud Functions connect.
#    No password travels over a network, and no IP allow-listing is needed.
#    Find the instance connection name on the Cloud SQL instance page.
# INSTANCE_UNIX_SOCKET=/cloudsql/edupay-ug:europe-west1:edupay-db
# DB_USER=edupay
# DB_PASSWORD=
# DB_NAME=edupay
#
# 2. CLOUD SQL AUTH PROXY — the recommended way to connect from a laptop.
#      ./cloud-sql-proxy edupay-ug:europe-west1:edupay-db --port 5432
#    The proxy handles TLS and IAM, so no certificates are needed here.
DATABASE_URL=postgresql://edupay:password@127.0.0.1:5432/edupay
#
# 3. DIRECT TCP WITH TLS — for hosts outside Google Cloud. Requires the
#    instance's public IP, an authorised network, and the server CA from
#    Cloud SQL → Connections → Security. Without DB_SSL_CA the connection is
#    encrypted but the server is not verified, and a warning is logged.
# DB_HOST=
# DB_PORT=5432
# DB_USER=edupay
# DB_PASSWORD=
# DB_NAME=edupay
# DB_SSL=true
# DB_SSL_CA=./cloud-sql-server-ca.pem
# DB_SSL_CERT=
# DB_SSL_KEY=

# Connection pool. Keep PG_POOL_MAX below the instance's max_connections
# divided by the number of running instances — Cloud SQL's smallest tiers
# allow relatively few.
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
PG_SLOW_QUERY_MS=500

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# At least 32 characters. The server REFUSES TO START in production without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long an access token stays valid.
JWT_TTL=2h

# bcrypt work factor. Higher is slower and stronger.
BCRYPT_ROUNDS=12

# Minimum password length. The policy also requires three of:
# lowercase, uppercase, digits, symbols.
PASSWORD_MIN_LENGTH=10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public base URL, used to build links in emails. Without it the request's own
# host is used — set it explicitly behind a proxy or load balancer.
# BASE_URL=https://payroll.yourschool.ac.ug

# Comma-separated browser origins allowed to call the API. Leave empty when the
# API and the pages are served from the same origin, which is the default.
# ALLOWED_ORIGINS=https://payroll.yourschool.ac.ug

# Proxy hops to trust when reading the client IP for rate limiting and the
# audit log. 1 suits a single load balancer; Cloud Run sits behind one.
TRUST_PROXY_HOPS=1

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Email (strongly recommended)
# ---------------------------------------------------------------------------
# Without SMTP the system still runs, but it cannot send password setup links,
# password resets or two-factor codes. New accounts then fall back to a
# one-time temporary password shown to the administrator instead, and
# two-factor authentication stays off because codes could not be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yourschool.ac.ug

# ---------------------------------------------------------------------------
# Two-factor authentication and tokens
# ---------------------------------------------------------------------------
MFA_TOKEN_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
PASSWORD_SETUP_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Sign-in and verify attempts per IP per 15 minutes.
RATE_LIMIT_AUTH=20
# Email-sending requests per IP per hour.
RATE_LIMIT_EMAIL=5
# All API requests per IP per minute.
RATE_LIMIT_API=300

# ---------------------------------------------------------------------------
# First-run seeding (npm run db:seed)
# ---------------------------------------------------------------------------
# Only used when no administrator exists yet. Leave SEED_ADMIN_PASSWORD unset
# to have a strong one generated and printed once.
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration and constraint suites need a throwaway database, and refuse to
# run unless its name contains "test". Without this they skip, so `npm test`
# still works with no database at all.
# TEST_DATABASE_URL=postgresql://edupay:password@127.0.0.1:5432/edupay_test
