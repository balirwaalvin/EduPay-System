rules_version = '2';

// EduPay Firestore security rules.
//
// All application access goes through the Express API using the Admin SDK, which
// bypasses these rules by design. They therefore act as a deny-all backstop: if
// the web API key in the browser bundle is ever used to talk to Firestore
// directly, it gets nothing. Payroll authorisation is enforced in the API, not
// here, because it depends on workflow state that rules cannot evaluate.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
